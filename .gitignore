# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.load-test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees (isolated workspaces)
.worktrees/

# Visual companion brainstorming files
.superpowers/

# AI tool working directories
.claude/
.claire/

# Load test outputs and credentials
.env.load-test
load-tests/results/*.json

# Terraform — state and secrets
infra/.terraform/
infra/.terraform.lock.hcl
infra/terraform.tfvars
infra/terraform.tfstate
infra/terraform.tfstate.backup

/test-results/
/playwright-report/
/playwright/.cache/
